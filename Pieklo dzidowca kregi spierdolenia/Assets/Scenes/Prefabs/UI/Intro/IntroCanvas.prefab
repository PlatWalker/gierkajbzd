MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8647611760313190744}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 25
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 2
    m_MaxSize: 57
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.09
  m_Text: "Anon to z pozoru zwyk\u0142y siedemnastolatek, b\u0119d\u0105cy w\u0142a\u015Bnie
    na ko\u0144cu okresu dojrzewania. UNTIL HE WASN'T! \u017Bart w kilku pierwszych
    sekundach gry, nie\u017Ale, nie? (chrz\u0105kni\u0119cie) Na pierwszy rzut oka
    w\u0142a\u015Bnie tym mo\u017Cna by wyt\u0142umaczy\u0107 jego introwertyczne
    podej\u015Bcie do r\xF3wie\u015Bnik\xF3w czy problemy wychowawcze. Jednak prawda
    jest zupe\u0142nie inna. Ch\u0142opak \u017Cyje na jednym z miejskich blokowisk
    razem ze swoj\u0105 patologiczn\u0105 matk\u0105 i niestroni\u0105cym od alkoholu
    ojczymem, przez kt\xF3rych jest traktowany jak s\u0142u\u017C\u0105cy. Problemy
    w rodzinie s\u0105 powodem, dla kt\xF3rych Anon zamyka si\u0119 w sobie, jest
    nie\u015Bmia\u0142y w podej\u015Bciu do dziewczyn oraz pozwala na ka\u017Cdym
    kroku sob\u0105 pomiata\u0107. Dzie\u0144, od kt\xF3rego zaczniemy nasz\u0105
    histori\u0119, zapowiada\u0142 si\u0119 jak ka\u017Cdy inny w jego dotychczasowym
    \u017Cyciu... UNTIL IT WASN'T! Hehe, \u017Cart wyruchany dwa razy, klasyka. "
