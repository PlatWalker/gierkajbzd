          OutputGuid: d44edfb9-7d14-497d-8ef3-7d4bf064082f
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "I jak, m\u0142ody? Masz t\u0119 flaszk\u0119?"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107192
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 4c7184b2-6bd2-4311-9da2-e86cc115312c
        <Position>k__BackingField: {x: 1824.5, y: -252.5}
