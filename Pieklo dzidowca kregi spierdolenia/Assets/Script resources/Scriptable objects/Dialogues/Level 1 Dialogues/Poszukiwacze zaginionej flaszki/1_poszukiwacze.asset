    - rid: 4751322063800107188
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: d67bad6b-f12b-4621-bca6-60125d417a57
        <Position>k__BackingField: {x: 1025, y: 249}
        <DialogueNodePorts>k__BackingField:
