          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Te, J\xF3zwa! Cho no tu!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107194
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: cb62cbc1-c3c6-4630-8caf-97b235b0f071
        <Position>k__BackingField: {x: 3087.5, y: -288.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 9279c06b-4eb7-42b6-8e6c-f142d6d878c9
          InputGuid: 4b054cf6-768a-473d-b092-d6d2a1156722
          OutputGuid: cb62cbc1-c3c6-4630-8caf-97b235b0f071
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Czego drzesz mord\u0119?"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: b20e773fbde419f4ebba247c92965fd0, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: "J\xF3zek"
    - rid: 4751322063800107195
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 4b054cf6-768a-473d-b092-d6d2a1156722
        <Position>k__BackingField: {x: 3716, y: -296.5}
