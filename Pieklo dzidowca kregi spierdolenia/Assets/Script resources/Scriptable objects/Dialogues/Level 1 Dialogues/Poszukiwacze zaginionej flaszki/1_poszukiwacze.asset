          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Zajeba\u0142?!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
