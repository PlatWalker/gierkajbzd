    - rid: 4751322063800107193
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 39102bf4-81fa-4b9d-a0d4-d8249c78e681
        <Position>k__BackingField: {x: 2458, y: -279.5}
        <DialogueNodePorts>k__BackingField:
