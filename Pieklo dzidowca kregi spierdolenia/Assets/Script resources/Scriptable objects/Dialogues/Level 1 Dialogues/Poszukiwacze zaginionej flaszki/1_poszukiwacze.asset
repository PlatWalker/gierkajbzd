          OutputGuid: 4b054cf6-768a-473d-b092-d6d2a1156722
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Kto\u015B zajeba\u0142 nam \u201E\u015Awi\u0119tego
          Graala\u201D...\n"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107196
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: d8d9d6a7-f317-4953-9d2c-48971649730f
        <Position>k__BackingField: {x: 4344, y: -317}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 4e6a06e3-f531-4a15-a92b-1c27d80856ab
          InputGuid: 7a880d32-0460-4da6-a9e1-19c5bfd0c91c
          OutputGuid: d8d9d6a7-f317-4953-9d2c-48971649730f
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: Nie pierdol!
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 80d98c0a6bbeac847a7bdb17ba7bd4e5, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: "J\xF3zek"
    - rid: 4751322063800107197
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 7a880d32-0460-4da6-a9e1-19c5bfd0c91c
        <Position>k__BackingField: {x: 4969, y: -313.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 6520de53-c501-45ab-ab94-a47ffcaf4d69
          InputGuid: c2b0e332-d9e9-415a-9684-63c0f64b5acd
          OutputGuid: 7a880d32-0460-4da6-a9e1-19c5bfd0c91c
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Musimy znale\u017A\u0107 tego zajebanego z\u0142odzieja.
          Piszesz si\u0119?"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107198
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: c2b0e332-d9e9-415a-9684-63c0f64b5acd
        <Position>k__BackingField: {x: 5598.5, y: -315.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 1270eb88-2e06-4170-bb71-f6035141b7c2
          InputGuid: 649d4957-1d4f-4f9e-8e60-2f840f7acd63
          OutputGuid: c2b0e332-d9e9-415a-9684-63c0f64b5acd
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "W sumie to g\xF3wno w tej sprawie mog\u0119 zrobi\u0107.
          Ale pierdoln\u0105\u0107 sobie takiego Graala, to bym pierdoln\u0105\u0142..."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 5804618884b55af47ab30ad4a8ee9877, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: "J\xF3zek"
    - rid: 4751322063800107199
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 649d4957-1d4f-4f9e-8e60-2f840f7acd63
        <Position>k__BackingField: {x: 6221.5, y: -317.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 727d3a7c-4fd3-4aa9-9436-fcbf7141d2e8
          InputGuid: 0ef7ac2e-8208-4c09-922f-e9a376440135
          OutputGuid: 649d4957-1d4f-4f9e-8e60-2f840f7acd63
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Chyba ci\u0119 popierdoli\u0142o! Chla\u0107 to ka\u017Cdy,
          ale robi\u0107 to nie ma komu!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Endrju
    - rid: 4751322063800107200
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 0ef7ac2e-8208-4c09-922f-e9a376440135
        <Position>k__BackingField: {x: 6852.5, y: -314.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 31a41851-99f2-4b19-bf82-cf3b23c2288e
          InputGuid: 3b1e9075-6701-4cb0-b7cb-ad9439b9953a
          OutputGuid: 0ef7ac2e-8208-4c09-922f-e9a376440135
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Spokojnie, Andrzeju, nie denerwuj si\u0119... Akurat
          znam kogo\u015B, kto m\xF3g\u0142by nam pom\xF3c."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 5804618884b55af47ab30ad4a8ee9877, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: "J\xF3zek"
    - rid: 4751322063800107201
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 3b1e9075-6701-4cb0-b7cb-ad9439b9953a
        <Position>k__BackingField: {x: 7480, y: -320}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 2e30f184-82b3-495a-9833-9eca44c5eed0
          InputGuid: 3c64de65-5f2a-4434-ad28-f6c1d687c072
          OutputGuid: 3b1e9075-6701-4cb0-b7cb-ad9439b9953a
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: Niby kogo?
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Endrju
    - rid: 4751322063800107202
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 3c64de65-5f2a-4434-ad28-f6c1d687c072
        <Position>k__BackingField: {x: 8099, y: -310.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 756d3fd3-d6e1-4841-914e-00d3596f959b
          InputGuid: 3dc7e01f-f2de-44b7-a872-c1318e4c4914
          OutputGuid: 3c64de65-5f2a-4434-ad28-f6c1d687c072
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Staszek. Przecie\u017C w wojsku by\u0142. Pewnie
          potrafi wytropi\u0107 kradn\u0105cych wino skurwysyn\xF3w z odleg\u0142o\u015Bci
          pi\u0119ciu kilometr\xF3w."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 5804618884b55af47ab30ad4a8ee9877, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: "J\xF3zek"
    - rid: 4751322063800107203
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 3dc7e01f-f2de-44b7-a872-c1318e4c4914
        <Position>k__BackingField: {x: 8723.5, y: -311}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 90dd3b99-44c7-4dd8-9009-92d7f95690e2
          InputGuid: c023274e-7c71-43bd-9c94-36eb246c834b
          OutputGuid: 3dc7e01f-f2de-44b7-a872-c1318e4c4914
          Text: "Sk\u0105d mam wiedzie\u0107, gdzie jest Stachu?"
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "M\u0142ody, jeszcze raz musimy ci\u0119 prosi\u0107
          o przys\u0142ug\u0119. Znajd\u017A Stacha i przekonaj go, \u017Ceby pom\xF3g\u0142
          nam z\u0142apa\u0107 tego zajebanego kradzieja. Sami by\u015Bmy poszli,
          ale rozumiesz... Prawdziwy \u017Co\u0142nierz nie opuszcza swojego posterunku."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107204
      type: {class: CreateCheckpointNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: c023274e-7c71-43bd-9c94-36eb246c834b
        <Position>k__BackingField: {x: 9369, y: -306}
        CheckpointTag: poszukiwacze
        CheckpointName: poszuk4
        Level: 0
    - rid: 4751322063800107205
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: e169b628-46f1-4199-a440-c7a2494da0e5
        <Position>k__BackingField: {x: 9638.5, y: -303}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 197bc450-5a4a-4437-980f-e6755447a905
          InputGuid: a49e32a5-e62c-4ce7-8982-edba65eb8fe9
          OutputGuid: e169b628-46f1-4199-a440-c7a2494da0e5
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "To nie b\u0119dzie trudne. Jak go znam, to le\u017Cy
          najebany na cmentarzu. Odk\u0105d jego szwagier umar\u0142 na marsko\u015B\u0107
          w\u0105troby, to odwiedza go i chleje, jak to m\xF3wi \u201Erazem z nim\u201D.
          Jak dla mnie, to zdrowo jest pierdolni\u0119ty..."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322063800107206
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
