          OutputGuid: 61e247de-49c4-40de-a49a-82a9b18c5890
          Text: Koniec
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "\u015Awietnie! Oto dwa z\u0142ote! Pospiesz si\u0119,
          m\u0142ody, bo nas suszy jak ja pierdole!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
