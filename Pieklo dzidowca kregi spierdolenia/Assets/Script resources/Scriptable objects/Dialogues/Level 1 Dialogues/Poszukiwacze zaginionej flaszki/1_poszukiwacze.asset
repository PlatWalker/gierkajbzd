    - rid: 4751322063800107190
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: be8ed8ae-ba9d-463d-914b-f4064e3340e3
