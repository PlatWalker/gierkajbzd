          InputGuid: 7db92cea-e2bc-468a-800b-2e69cc1b5318
          OutputGuid: 3f0861d7-1d2f-47f7-b632-7acc4125cbb5
          Text: Koniec
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "W\u0142a\u015Bnie, kto nakarmi mojego kota?"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 509c7ad8a6765dc4f8b7da8239bd0e7e, type: 3}
