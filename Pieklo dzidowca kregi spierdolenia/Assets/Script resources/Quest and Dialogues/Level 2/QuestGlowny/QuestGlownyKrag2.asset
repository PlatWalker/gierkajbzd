        <IsStartingDialogue>k__BackingField: 0
        <Quest>k__BackingField: {fileID: 11400000, guid: 35fc97952821e5f48959bed995be9ac1, type: 2}
        <IsQuestStart>k__BackingField: 1
    - rid: 6007911982781956811
      type: {class: EndGroupRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 5348bd82-4bde-46d1-b7d5-cc1679091c0f
        <Choices>k__BackingField: []
        <NodeType>k__BackingField: 7
        <IsStartingDialogue>k__BackingField: 0
        <SelectedGroup>k__BackingField: SzerszenDialogue
    - rid: 6007911982781956812
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 2ce20e88-e162-48c0-a248-3eea61f574a8
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 0a1ac998-4f90-49c7-bbc7-622fd90afeb8
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Nazywam si\u0119 Hed. "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956813
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 401e1762-7675-4a8d-891a-7879694fec0e
        <Choices>k__BackingField:
        - <Text>k__BackingField: 'Co to za miejsce? '
          <NextDialogue>k__BackingField: 4b4851de-f7ec-4108-b69e-4625904a0328
        - <Text>k__BackingField: "Dlaczego mi pomog\u0142e\u015B? "
          <NextDialogue>k__BackingField: eaa95eb5-ae7b-496f-93ab-d52f6b823853
        - <Text>k__BackingField: "Kim jeste\u015B? "
          <NextDialogue>k__BackingField: adf6fb1c-28cf-4cd7-9e78-818b9eee3f05
        - <Text>k__BackingField: "To wszystko, co musz\u0119 wiedzie\u0107. "
          <NextDialogue>k__BackingField: 15723cec-a696-4556-af15-e7034beea3a5
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Jakie\u015B pytania, Anon? "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956814
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 7a40a35e-1286-4602-995d-34c4a6272265
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 4840918e-8d9b-4bf9-84e1-0f14adc3a10b
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Jeb z Dzidy\u2026 "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956815
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: c168f83f-70cc-4bba-8f2e-99ef4c334881
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 7a40a35e-1286-4602-995d-34c4a6272265
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Znaczy si\u0119 chcesz, \u017Cebym ci podpowiedzia\u0142,
          \u017Ce sam musisz znale\u017A\u0107 swoje miejsce w internecie? Pozwiedzaj
          troch\u0119, uwa\u017Caj na trolli i baw si\u0119 dobrze. Na pewno jaka\u015B
          strona ci\u0119 zaciekawi na tyle, \u017Ce b\u0119dziesz chcia\u0142 stworzy\u0107
          tam konto. "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956816
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 459e28ae-d444-4018-918a-7410c0ae3440
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: c168f83f-70cc-4bba-8f2e-99ef4c334881
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Przecie\u017C sam powiedzia\u0142e\u015B, \u017Ce
          to wszystko, co musisz wiedzie\u0107. Chcesz, \u017Cebym zaspojlerowa\u0142,
          \u017Ce musisz si\u0119 dosta\u0107 na Jeb z Dzidy? "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956817
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 0737d141-d0dc-48e2-a5e8-2883d813a20b
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 459e28ae-d444-4018-918a-7410c0ae3440
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "A dok\u0105d to w\u0142a\u015Bciwie idziemy? "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 1
    - rid: 6007911982781956818
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 15723cec-a696-4556-af15-e7034beea3a5
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 0737d141-d0dc-48e2-a5e8-2883d813a20b
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Mo\u017Ce i tak, ale kontrakt wymusza na mnie par\u0119
          kwestii dialogowych wi\u0119cej. B\u0119dzie lepiej jak p\xF3jd\u0119 z
          tob\u0105. "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956819
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 0a1ac998-4f90-49c7-bbc7-622fd90afeb8
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 94a8dbd5-8abe-4e99-9394-6bfaeb160d24
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: Jestem...
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 1
    - rid: 6007911982781956820
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 94a8dbd5-8abe-4e99-9394-6bfaeb160d24
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 401e1762-7675-4a8d-891a-7879694fec0e
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Nie interesuje mnie kim jeste\u015B. Dla mnie jeste\u015B
          Anon i tak teraz wszyscy b\u0119d\u0105 ci\u0119 nazywa\u0107."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956821
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 7e95c9a6-a466-44ff-a75b-9c60ac5b77d7
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 570fcf2e-d44a-4c4d-a090-5ac420bc82a3
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Ja? A co z Tob\u0105? "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
