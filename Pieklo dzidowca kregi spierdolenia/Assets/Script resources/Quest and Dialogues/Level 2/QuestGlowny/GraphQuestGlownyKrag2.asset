    - rid: 6007911982781956767
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: fd739b6b-a26a-4e3e-ba28-b478d53ca80e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 03f949a3-621d-4a60-94fb-3073484db694
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 6913, y: 3599}
        <Text>k__BackingField: "O, to wpisz, \u017Ce jestem u\u017Cytkownikiem portalu
          Jeb z Dzidy, bossem drugiego kr\u0119gu. Co, spojler?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956768
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 03f949a3-621d-4a60-94fb-3073484db694
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 8ac1466e-8e4c-471c-9492-927393e8e0ce
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 7555, y: 3599}
        <Text>k__BackingField: "Kt\xF3re to ju\u017C \u0142amanie czwartej \u015Bciany
          w tej grze, nie nudzi ci si\u0119? Dopisz, \u017Ce jest cieciem."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956769
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 8ac1466e-8e4c-471c-9492-927393e8e0ce
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 7a3b5864-23b2-4a79-a82b-942067372f7e
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 8147, y: 3599}
        <Text>k__BackingField: "Nie cieciem tylko profesjonalnym bramkarzem. Nad\u0105\u017Casz
          z zapisywaniem?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956770
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 911578a8-d012-4b7a-b9b4-6c7261423ed2
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Patrz\u0105c na ciebie nie dziwi\u0119 si\u0119,
            \u017Ce wiesz, gdzie znale\u017A\u0107 kwejka."
          <NodeID>k__BackingField: f17bd356-9df4-4170-bb22-220911fc6405
        - <Text>k__BackingField: "Dzi\u0119ki, rozejrz\u0119 si\u0119."
          <NodeID>k__BackingField: 7a3b5864-23b2-4a79-a82b-942067372f7e
        - <Text>k__BackingField: "Bardziej chodzi\u0142o mi o Jeb z Dzidy."
          <NodeID>k__BackingField: bafc887c-4b36-46b7-8594-68f46f879981
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 1
        <Position>k__BackingField: {x: 6474, y: 3956}
        <Text>k__BackingField: "Patrz\u0105c na ciebie, to nie wiem\u2026 Mo\u017Ce
          Plotek albo Onet. Albo poszukaj kwejka, jest gdzie\u015B tutaj."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956771
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: f17bd356-9df4-4170-bb22-220911fc6405
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 60d95756-7b8b-44f5-b555-503f857d03b8
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 7148, y: 3956}
        <Text>k__BackingField: "A czy kto\u015B, kto wie, gdzie znale\u017A\u0107
          kwejka mo\u017Ce spu\u015Bci\u0107 ci taki wpierdol?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956772
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 60d95756-7b8b-44f5-b555-503f857d03b8
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 63587891-ff2b-4f16-870e-25e3b131fca9
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 7667, y: 3956}
        <Text>k__BackingField: "\rDobra robota. Zd\u0105\u017Cy\u0142e\u015B zrobi\u0107
          sejwa?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956773
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: bafc887c-4b36-46b7-8594-68f46f879981
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Skoro na Dzid\u0119 nie mo\u017Ce wej\u015B\u0107
            byle kto, to ju\u017C rozumiem, dlaczego stoisz przed drzwiami jak \u017Cul."
          <NodeID>k__BackingField: 741a2b54-f36b-4fe5-bb7e-2dcc4b556f9b
        - <Text>k__BackingField: Dobra, rozumiem.
          <NodeID>k__BackingField: 7a3b5864-23b2-4a79-a82b-942067372f7e
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 1
        <Position>k__BackingField: {x: 7148, y: 4322}
        <Text>k__BackingField: "Nie no, po to p\xF3\u0142 dnia jeba\u0142em si\u0119
          z tymi okopami, \u017Ceby wpuszcza\u0107 na dzid\u0119 byle kogo."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956774
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 741a2b54-f36b-4fe5-bb7e-2dcc4b556f9b
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 60d95756-7b8b-44f5-b555-503f857d03b8
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 7966, y: 4322}
        <Text>k__BackingField: "Zaraz ci poka\u017C\u0119, dlaczego wystawiono mnie
          na stra\u017Cy."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
