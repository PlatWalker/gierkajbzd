        <GroupID>k__BackingField: ce8f27e1-6ace-4207-8cc4-015ddf4a2084
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 381, y: 5681}
        <Text>k__BackingField: "Dobrze, \u017Ce pozby\u0142e\u015B si\u0119 tego
          trolla. Udowodni\u0142e\u015B, \u017Ce nie jeste\u015B jednym z nich. "
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
