        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956796
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 17ac70a6-411d-4a65-abc7-7074ef19d55c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: d56cc156-6010-4ca4-b39d-7bcc262d7d4f
        <GroupID>k__BackingField: f128acf3-dbf9-4abb-877c-b5d129141fc1
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2451, y: 4810}
        <Text>k__BackingField: "\u2026 *gry z kosza* nie sta\u0107 na inny spos\xF3b
          zap\u0142aty ni\u017C reklam\u0119. "
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
