        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956764
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: dd5773ee-ab4b-453f-98fd-b04a1f4ad943
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: d65ed17c-7528-47a5-b696-b50a1fcd3e1c
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 6913, y: 3249}
        <Text>k__BackingField: "Masz to napisane w oknie dialogowym, obok avataru
          NPC z kt\xF3rym rozmawiasz. Potrzebujesz tutorialu czy co\u015B?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 6007911982781956765
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: d65ed17c-7528-47a5-b696-b50a1fcd3e1c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 8979df96-e1d3-4a13-9fdd-bcbcf44d9352
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 7586, y: 3249}
        <Text>k__BackingField: "Ksi\u0105\u017Ck\u0119 piszesz?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
