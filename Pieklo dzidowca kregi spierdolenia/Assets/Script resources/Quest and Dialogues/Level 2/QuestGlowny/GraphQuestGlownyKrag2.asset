        - <Text>k__BackingField: "Wr\xF3g! "
          <NodeID>k__BackingField: 4986cc45-0724-4414-b319-9d978e8df91e
        - <Text>k__BackingField: 'Ja jestem z tym panem! '
          <NodeID>k__BackingField: ab7f13a9-0d0c-4dd9-9efe-047a8baf87e3
        - <Text>k__BackingField: "Co m\xF3wi\u0142e\u015B? "
