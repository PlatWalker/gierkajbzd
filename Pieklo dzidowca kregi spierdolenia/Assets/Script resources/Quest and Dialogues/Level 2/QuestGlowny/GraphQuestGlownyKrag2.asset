    - rid: 6007911982781956793
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: d0263f80-1e88-41fb-8e8f-bfcaf86d92e2
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 9ec7e4a2-5967-47c5-b637-167d84a41c85
        <GroupID>k__BackingField: 9865bd51-ea95-426a-98e3-123fda16e5ee
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 378, y: 4815}
        <Text>k__BackingField: "Wszystkie opcje dialogowe prowadz\u0105 do walki
          z bossem, oto iluzja wyboru, drodzy widzowie. Chyba zajm\u0119 si\u0119
          tym w najnowszym odcinku na kanale\u2026"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
