        <GroupID>k__BackingField: 9a6b5e35-f003-49a9-abb1-d41367b94130
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3142, y: 1489}
        <Text>k__BackingField: "Przecie\u017C sam powiedzia\u0142e\u015B, \u017Ce
          to wszystko, co musisz wiedzie\u0107. Chcesz, \u017Cebym zaspojlerowa\u0142,
          \u017Ce musisz si\u0119 dosta\u0107 na Jeb z Dzidy? "
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
