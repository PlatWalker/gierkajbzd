        - {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 1
    - rid: 6007911982781956800
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 570fcf2e-d44a-4c4d-a090-5ac420bc82a3
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 021fd1a3-8401-468e-adf2-a109d4552d39
        <GroupID>k__BackingField: e628767b-717c-4634-9650-027726927815
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1886, y: 1998}
        <Text>k__BackingField: "Przecie\u017C wiadomo, \u017Ce mnie znaj\u0105 wszyscy,
          jestem Hed! "
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 53b6e59808acfd64b9ea7a34cd263bd9, type: 3}
