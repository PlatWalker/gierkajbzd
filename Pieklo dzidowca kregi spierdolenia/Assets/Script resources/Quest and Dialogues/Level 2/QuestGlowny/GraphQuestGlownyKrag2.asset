    - rid: 6007911982781956787
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 3b9e23ef-d025-4f27-a355-74e1edc86419
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: deea7fb7-8292-4e63-9f81-79cdd8c453c1
        <GroupID>k__BackingField: ce8f27e1-6ace-4207-8cc4-015ddf4a2084
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2903, y: 5681}
        <Text>k__BackingField: "Jest jeszcze sporo innych Anon\xF3w, kt\xF3rzy potrzebuj\u0105
          znale\u017A\u0107 swoje miejsce w internecie. Poza tym um\xF3wi\u0142em
          si\u0119 z deweloperami na ma\u0142\u0105 rol\u0119 w tym badziewiu, nie
          b\u0119d\u0119 tu\u0142a\u0142 si\u0119 po Poczekalniach."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e656281b36f8f40b6e0ac1d6775b03, type: 3}
