    - rid: 6007911982781956784
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: b9310e53-03fa-40a1-b193-85332677f176
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 04620a9f-7bab-44b8-87f2-fb8eaabcbf03
        <GroupID>k__BackingField: ce8f27e1-6ace-4207-8cc4-015ddf4a2084
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1368, y: 5681}
        <Text>k__BackingField: "Pierdolonym wykopkiem. A to wystarczaj\u0105co, \u017Cebym
          m\xF3g\u0142 udzieli\u0107 ci wst\u0119pu do Dzidowej poczekalni."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
