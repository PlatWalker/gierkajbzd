      data:
        <NodeId>k__BackingField: 204e782a-61f2-46e6-a570-73bbbf19036e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 95fd2504-f233-4cab-8a87-05efaaf0a814
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Nic nie robisz, tylko chlejesz piwsko ca\u0142ymi
          dniami i jeszcze moje wychla\u0142e\u015B! Matka mia\u0142a racj\u0119,
          co do ciebie...!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: fb189889408b4ae4f88f77fdbcc0ab35, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
