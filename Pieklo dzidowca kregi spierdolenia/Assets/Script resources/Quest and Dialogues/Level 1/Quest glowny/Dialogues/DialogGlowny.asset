        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Ile razy mam Ci\u0119, kurwa, wo\u0142a\u0107? G\u0142uchy
          jeste\u015B czy pierdolni\u0119ty?"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 9c604109ef88abd47a7c2e719dd189ea, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2380491409021730868
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 204e782a-61f2-46e6-a570-73bbbf19036e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 95fd2504-f233-4cab-8a87-05efaaf0a814
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Nic nie robisz, tylko chlejesz piwsko ca\u0142ymi
          dniami i jeszcze moje wychla\u0142e\u015B! Matka mia\u0142a racj\u0119,
          co do ciebie...!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: fb189889408b4ae4f88f77fdbcc0ab35, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2380491409021730869
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 74124e8d-6e58-4f8e-b805-7a808e6ecaf6
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: fe018d0a-75fe-4c3b-94d0-7903ea991e18
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Ten komputer ju\u017C ci ca\u0142kiem na m\xF3zg
          siad\u0142! Wyszed\u0142by\u015B na dw\xF3r, przyda\u0142 si\u0119 do czego\u015B,
          a nie ca\u0142ymi dniami w tej norze siedzisz! \u017Badnego z ciebie po\u017Cytku,
          drugi ojciec..."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 9c604109ef88abd47a7c2e719dd189ea, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2380491409021730870
