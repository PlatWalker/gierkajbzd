    - rid: 2380491409021730881
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 019e410a-01bc-4341-90fc-d04f7ebff5bb
        <Choices>k__BackingField:
        - <Text>k__BackingField: Jasne, ale zagraj hymn ZSRR
          <NextDialogue>k__BackingField: 135b32c1-9368-44ce-8008-1704cc732022
        - <Text>k__BackingField: "Nie nosz\u0119 drobnych"
          <NextDialogue>k__BackingField: e375e2d3-822f-4925-94ee-bfd1c6a35c3e
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Te, masz pi\u0119\u0107 z\u0142ote?"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 94eb32407f3b1d744a0561f681755a2b, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2380491409021730882
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: e375e2d3-822f-4925-94ee-bfd1c6a35c3e
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Dobra, masz tu pi\u0119\u0107 z\u0142otych, ale
            zagraj hymn ZSRR"
          <NextDialogue>k__BackingField: d720bfec-33f9-4f58-baf7-fb5f2f356eb2
        - <Text>k__BackingField: Wypierdalaj!
          <NextDialogue>k__BackingField: 3a699b0a-5e9a-4351-a49a-7ba39905a637
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Mog\u0105 by\u0107 grube"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 94eb32407f3b1d744a0561f681755a2b, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2380491409021730883
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: d720bfec-33f9-4f58-baf7-fb5f2f356eb2
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 10a19a18-44fb-4971-8ab2-f289e6f7eb22
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Co? Ty, kurwa, \u015Bmieciu, m\xF3wi\u0142e\u015B,
          \u017Ce nie masz drobnych! Zaraz ci zagram, ale marsz \u017Ca\u0142obny!
