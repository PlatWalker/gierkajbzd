        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Zamknij w ko\u0144cu ten ryj, bo jak ci przypierdole..."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 37609932c1798044f8695c0547817fa2, type: 3}
