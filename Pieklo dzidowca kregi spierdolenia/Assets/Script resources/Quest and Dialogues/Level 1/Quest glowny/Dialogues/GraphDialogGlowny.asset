        <GroupID>k__BackingField: d89631dc-3f1e-4b45-9689-4485013a8cb3
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2514, y: 575}
        <Text>k__BackingField: "Ten komputer ju\u017C ci ca\u0142kiem na m\xF3zg
          siad\u0142! Wyszed\u0142by\u015B na dw\xF3r, przyda\u0142 si\u0119 do czego\u015B,
          a nie ca\u0142ymi dniami w tej norze siedzisz! \u017Badnego z ciebie po\u017Cytku,
          drugi ojciec..."
        <PlayerImage>k__BackingField: {fileID: 0}
