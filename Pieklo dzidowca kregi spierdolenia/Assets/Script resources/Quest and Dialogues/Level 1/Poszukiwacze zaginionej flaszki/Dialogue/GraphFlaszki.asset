    - rid: 222056510374281352
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 057af475-039a-424d-a954-fb052424addd
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: b19e3e54-df41-4d1f-9391-f1c9a3263be5
        <GroupID>k__BackingField: ffafb736-3a97-45fc-b146-8fc04a94e399
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1898, y: 9426}
        <Text>k__BackingField: "A to menda zapijaczona! Zaraz zadzwoni\u0119 na policj\u0119
          i..."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
