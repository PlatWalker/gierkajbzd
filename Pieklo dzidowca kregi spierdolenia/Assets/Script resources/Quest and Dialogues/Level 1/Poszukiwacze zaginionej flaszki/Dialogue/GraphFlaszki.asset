        <IsPlayerTalking>k__BackingField: 1
    - rid: 222056510374281265
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 0a1f0d86-7416-4a14-907f-cb07d452fb1f
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: e2ca55eb-c218-482b-b710-5509f563f23e
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1319, y: 4193}
        <Text>k__BackingField: A kto przy telefonie?
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
