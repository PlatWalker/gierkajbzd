        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1364, y: 9426}
        <Text>k__BackingField: "Zdzichu Jones. W\u0142ama\u0142 si\u0119 na zaplecze,
          korzystaj\u0105c z narz\u0119dzi \u015Blusarskich"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
