    - rid: 222056510374281354
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: e8fed3e5-6eaf-401e-bf85-fc6c011460ef
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: fddeb15a-bc2d-42c8-aa2a-7cee3d4891cc
        <GroupID>k__BackingField: ffafb736-3a97-45fc-b146-8fc04a94e399
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2833, y: 9426}
        <Text>k__BackingField: "I bardzo dobrze. O jednego pijaka mniej. Dzi\u0119kuj\u0119
          za pomoc w z\u0142apaniu z\u0142odzieja, ch\u0142opcze. Je\u017Celi tylko
          b\u0119dziesz chcia\u0142 co\u015B kupi\u0107, \u015Bmia\u0142o. Dostaniesz
          rabat sta\u0142ego klienta!"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 72e8b4e15ffef3b4aae9c6a92446789d, type: 3}
