      data:
        <ID>k__BackingField: 0cbf0f51-b39c-41b1-ac4c-b95fa4d7f375
        <Choices>k__BackingField:
        - <Text>k__BackingField: "W porz\u0105dku. Daj pieni\u0105dze."
          <NodeID>k__BackingField: 173f9ce3-6cfd-459d-acac-eb8a63ebfbfa
        - <Text>k__BackingField: "Nie mam czasu na pierdo\u0142y"
          <NodeID>k__BackingField: 23879d31-9664-46b8-b1af-2181faef8efa
        <GroupID>k__BackingField: 6806d5c9-7eb3-4983-8ef0-b2db2e260f12
        <NodeType>k__BackingField: 1
        <Position>k__BackingField: {x: 443, y: 1204}
        <Text>k__BackingField: "Ta stara klempa wci\u0105\u017C k\u0142amie, \u017Ce
          nie ma \u201E\u015Awi\u0119tego Graala\u201D. To jak b\u0119dzie m\u0142ody?
          Pomo\u017Cesz nam? Bo zaraz si\u0119 odwodnimy.\r"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 8b0fb904dd04b9e4caf726c0f3ae2379, type: 3}
