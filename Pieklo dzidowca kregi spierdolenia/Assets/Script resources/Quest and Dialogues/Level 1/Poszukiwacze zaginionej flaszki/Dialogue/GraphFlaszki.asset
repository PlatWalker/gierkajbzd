        <ID>k__BackingField: 42cf9ff9-3d78-4149-a8cc-8d0a0c67b865
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Poprosz\u0119 \u201E\u015Awi\u0119tego Graala\u201D"
          <NodeID>k__BackingField: 2ac1a6ff-b7f2-464e-b015-fda9c27c4b3c
        - <Text>k__BackingField: Do widzenia
          <NodeID>k__BackingField: befb673e-fe45-4f2a-9be9-6fa89a4fdca2
        <GroupID>k__BackingField: 5b188c6f-a78f-4ffb-83e8-00ed4dd0dccf
