    - rid: 222056510374281274
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: c849e64a-f6b7-4e92-a6b7-fdb49f9d6f6a
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 781e0c29-535d-40ec-98ac-b53eeb74a063
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 912, y: 3312}
        <Text>k__BackingField: "Czego drzesz mord\u0119?"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b20e773fbde419f4ebba247c92965fd0, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281275
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: fc445804-ac91-4ca8-9897-66b4b10677de
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 268aade3-b0f9-49fb-9faa-3b6f47b45351
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2719, y: 3312}
        <Text>k__BackingField: "W sumie to g\xF3wno w tej sprawie mog\u0119 zrobi\u0107.
          Ale pierdoln\u0105\u0107 sobie takiego Graala, to bym pierdoln\u0105\u0142..."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 2c4a95626a512b746b1729685b9d33fb, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281276
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 268aade3-b0f9-49fb-9faa-3b6f47b45351
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: e3078c60-59ab-4f8b-b790-e66c7881818c
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3381, y: 3312}
        <Text>k__BackingField: "Chyba ci\u0119 popierdoli\u0142o! Chla\u0107 to ka\u017Cdy,
          ale robi\u0107 to nie ma komu!\r\n"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281277
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: e3078c60-59ab-4f8b-b790-e66c7881818c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 9b1a6985-7d2e-4af9-9bf9-b862fb03cf98
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3839, y: 3312}
        <Text>k__BackingField: "Spokojnie, Andrzeju, nie denerwuj si\u0119... Akurat
          znam kogo\u015B, kto m\xF3g\u0142by nam pom\xF3c."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 2c4a95626a512b746b1729685b9d33fb, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281278
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 9b1a6985-7d2e-4af9-9bf9-b862fb03cf98
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 033de473-56dc-41d6-8ff6-718739300434
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 461, y: 3707}
        <Text>k__BackingField: "Niby kto?\r"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281279
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 033de473-56dc-41d6-8ff6-718739300434
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 8abdee1c-4b37-443f-9063-e6c93addc0dd
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 878, y: 3707}
        <Text>k__BackingField: "Staszek. Przecie\u017C w wojsku by\u0142. Pewnie
          potrafi wytropi\u0107 kradn\u0105cych wino skurwysyn\xF3w z odleg\u0142o\u015Bci
          pi\u0119ciu kilometr\xF3w."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 2c4a95626a512b746b1729685b9d33fb, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281280
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 8abdee1c-4b37-443f-9063-e6c93addc0dd
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: becedd3b-0f02-49d8-af70-d68767e9d4f7
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1544, y: 3707}
        <Text>k__BackingField: "M\u0142ody, jeszcze raz musimy ci\u0119 prosi\u0107
          o przys\u0142ug\u0119. Znajd\u017A Stacha i przekonaj go, \u017Ceby pom\xF3g\u0142
          nam z\u0142apa\u0107 tego zajebanego kradzieja. Sami by\u015Bmy poszli,
          ale rozumiesz... Prawdziwy \u017Co\u0142nierz nie opuszcza swojego posterunku."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281281
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: becedd3b-0f02-49d8-af70-d68767e9d4f7
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 35ad8b9d-5930-4e74-a0e8-b25bc1dc6104
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2219, y: 3707}
        <Text>k__BackingField: "Sk\u0105d mam wiedzie\u0107, gdzie jest Stachu?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 1
    - rid: 222056510374281282
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 35ad8b9d-5930-4e74-a0e8-b25bc1dc6104
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: d0689fa1-2ce9-4154-b98b-151040fe9b7e
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2650, y: 3707}
        <Text>k__BackingField: "To nie b\u0119dzie trudne. Jak go znam, to le\u017Cy
          najebany na cmentarzu. Odk\u0105d jego szwagier umar\u0142 na marsko\u015B\u0107
          w\u0105troby, to odwiedza go i chleje, jak to m\xF3wi \u201Erazem z nim\u201D.
          Jak dla mnie, to zdrowo jest pierdolni\u0119ty."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 2c4a95626a512b746b1729685b9d33fb, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281283
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: d0689fa1-2ce9-4154-b98b-151040fe9b7e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 22dc6a58-c4aa-4485-b74f-5265717bec39
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3325, y: 3707}
        <Text>k__BackingField: "Troch\u0119 szkoda ch\u0142opa"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 57e38cf21b0f45a42bff7345ec575323, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281284
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 22dc6a58-c4aa-4485-b74f-5265717bec39
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 60c1ef08-7bd1-4e02-bbe7-0d8ef028e96f
        <GroupID>k__BackingField: 5cfd1dc0-67f0-4c43-8a2c-c09ce6525727
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3762, y: 3707}
        <Text>k__BackingField: "\rDobra, m\u0142ody. Wiesz, co i jak. B\u0119dziemy
          tu na was czeka\u0107.\r\n"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281285
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 3e57eb94-b7b9-4486-9901-02b1d7964333
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 4118563a-e9c3-4b39-9d09-eae513dabe69
        <GroupID>k__BackingField: 31a98701-dcd4-4400-ae58-ba09bec6c255
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 470, y: 2439}
        <Text>k__BackingField: "I jak, m\u0142ody? Masz t\u0119 flaszk\u0119?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
