    - rid: 222056510374281261
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 2ac1a6ff-b7f2-464e-b015-fda9c27c4b3c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 321bbab3-e69e-4534-8221-7afefb41fcdc
        <GroupID>k__BackingField: 5b188c6f-a78f-4ffb-83e8-00ed4dd0dccf
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 958, y: 1821}
        <Text>k__BackingField: "O, nast\u0119pny! Jeste\u015B od Zdzicha, tak? Ju\u017C
          m\xF3wi\u0142am tym moczymordom, \u017Ce nie mam czego\u015B takiego w
          sprzeda\u017Cy! Dosta\u0142am tylko jedn\u0105 butelk\u0119 od producenta,
          w celach marketingowych, ale kto\u015B j\u0105 ukrad\u0142, zanim zd\u0105\u017Cy\u0142am
          wystawi\u0107 j\u0105 na p\xF3\u0142k\u0119! W sumie sama bym chcia\u0142a
          wiedzie\u0107, co si\u0119 sta\u0142o z tym winiaczem..."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 36dbd3da4d777a2458e0042fc459dec0, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281262
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: ba9f33b9-34f9-4487-9cfa-4c256a9d0b80
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 9c9ead1c-4240-4dda-a2af-dfe745247f03
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 457, y: 4193}
        <Text>k__BackingField: "M\xF3wi\u0119 ci, Micha\u0142ku. Zasrane to \u017Cycie."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b823da9b96a205644ae2f0f0a944e584, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281263
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: e2ca55eb-c218-482b-b710-5509f563f23e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 324da998-8239-4e45-85c5-6a6841ee8b4e
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1751, y: 4193}
        <Text>k__BackingField: "Zdzichu Jones z ekip\u0105 potrzebuj\u0105 twojej
          pomocy.\r"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 1
    - rid: 222056510374281264
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 9c9ead1c-4240-4dda-a2af-dfe745247f03
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 0a1f0d86-7416-4a14-907f-cb07d452fb1f
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 888, y: 4193}
        <Text>k__BackingField: "Stachu?\r"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b823da9b96a205644ae2f0f0a944e584, type: 3}
