        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281266
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 0faac726-445b-4e2b-9c64-e1790d6e621a
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: cd834e91-76b4-49ec-a694-07e5f8cb3961
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3461, y: 4193}
        <Text>k__BackingField: "\u201EGraala\u201D?! Gra\u017Cynka mia\u0142a go
          dla mnie przetrzyma\u0107, a\u017C uzbieram dwa z\u0142ote! Brakuje mi
          jeszcze... dwa z\u0142ote..."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 489b378ea2814d7479cc1d2db0094d3e, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281267
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 1ce7d8cf-53bb-45f8-9923-d330e7d72a20
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 0faac726-445b-4e2b-9c64-e1790d6e621a
        <GroupID>k__BackingField: 87074c2c-4ceb-4472-91e7-d5dc19a7aa27
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2860, y: 4193}
        <Text>k__BackingField: "Kurwa, Stachu, wstawaj! Ojczyzna ci\u0119 potrzebuje!
          Kto\u015B podpierdoli\u0142 \u201E\u015Awi\u0119tego Graala\u201D!\r"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        LeftAdditionalImages: []
