      data:
        <NodeId>k__BackingField: 0ec46d63-6bbb-4e9c-9cdf-e717cda98a85
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 559cf937-d083-42b9-b66a-370b81d3bfb9
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Daj spok\xF3j, Zbysiu. We\u017Amiemy co\u015B innego."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 57e38cf21b0f45a42bff7345ec575323, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281379
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 559cf937-d083-42b9-b66a-370b81d3bfb9
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: bf510dda-48f2-42c8-9218-0a7aa2dae36a
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Kurwa, sk\u0142adali\u015Bmy si\u0119 czy nie? Wi\u0119c
          te\u017C mam prawo wybra\u0107. A ja nic poza \u201E\u015Awi\u0119tym Graalem\u201D
          pi\u0142 nie b\u0119d\u0119."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages: []
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 1
    - rid: 222056510374281380
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: bf510dda-48f2-42c8-9218-0a7aa2dae36a
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 36c33574-8fb1-4571-a1eb-309f1d339472
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: Kurwa, patrzcie, jaki francuski piesek zajebany! Wino
          mu nie smakuje...
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 40e44573e52ea0f41941cb9e1d87bb24, type: 3}
