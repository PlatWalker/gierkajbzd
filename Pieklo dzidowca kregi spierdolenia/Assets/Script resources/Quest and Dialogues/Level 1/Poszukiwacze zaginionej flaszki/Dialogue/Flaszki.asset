        <IsStartingDialogue>k__BackingField: 0
        <SelectedGroup>k__BackingField: FirstTalkToMenels
    - rid: 222056510374281382
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: dc65e132-19c9-4b74-8389-b4ace1df256f
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Nie mam \u017Cadnych pieni\u0119dzy"
          <NextDialogue>k__BackingField: 4c29bb33-1c25-49d8-881c-5750c0c63005
        - <Text>k__BackingField: Wypierdalaj!
          <NextDialogue>k__BackingField: c0384a19-0a27-4166-b414-6b70310b35b5
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Kierowniku! Spraw\u0119 mamy do ciebie! Poratujesz?\r"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 8b0fb904dd04b9e4caf726c0f3ae2379, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages:
        - {fileID: 21300000, guid: 57e38cf21b0f45a42bff7345ec575323, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 0
    - rid: 222056510374281383
      type: {class: EndGroupRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: c0384a19-0a27-4166-b414-6b70310b35b5
        <Choices>k__BackingField: []
        <NodeType>k__BackingField: 7
        <IsStartingDialogue>k__BackingField: 0
        <SelectedGroup>k__BackingField: FirstTalkToMenels
    - rid: 222056510374281384
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 4c29bb33-1c25-49d8-881c-5750c0c63005
        <Choices>k__BackingField:
        - <Text>k__BackingField: "W porz\u0105dku. Daj pieni\u0105dze."
          <NextDialogue>k__BackingField: 3b2ba917-9866-4fb4-aafe-34b3604b7199
        - <Text>k__BackingField: "Nie mam czasu na pierdo\u0142y"
          <NextDialogue>k__BackingField: 531d4ff2-0fa0-4b13-93cd-66d9faa991e5
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Nie chodzi o \u017Cadne pieni\u0105dze! Wr\u0119cz
          przeciwnie, bo akurat mamy dwa z\u0142ote. Chcemy Ci\u0119 poprosi\u0107
          o drobn\u0105 przys\u0142ug\u0119. Id\u017A do Gra\u017Cyny i kup \u201E\u015Awi\u0119tego
          Graala\u201D, to takie wino. Stara rura nie chce go sprzeda\u0107, bo to
          edycja limitowana. Pewnie trzyma dla kogo\u015B innego."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 8b0fb904dd04b9e4caf726c0f3ae2379, type: 3}
        LeftAdditionalImages: []
        RigthAdditionalImages:
