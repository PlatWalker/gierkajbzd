      data:
        <ID>k__BackingField: a7b9c1eb-ed6f-4039-be7f-4feef6bba848
        <Choices>k__BackingField:
        - <Text>k__BackingField: "W porz\u0105dku. Daj pieni\u0105dze."
          <NodeID>k__BackingField: d5be6307-2646-48bd-93f1-b4ace82d8529
        - <Text>k__BackingField: "Nie mam czasu na pierdo\u0142y"
          <NodeID>k__BackingField: 8a454214-d00d-49f6-a823-bb7a06436e0f
        <GroupID>k__BackingField: f9fbacb0-de54-4f1e-b0af-7ba1fa9a1e91
        <NodeType>k__BackingField: 1
        <Position>k__BackingField: {x: 2016, y: 105}
        <Text>k__BackingField: Tekst dialogu...
