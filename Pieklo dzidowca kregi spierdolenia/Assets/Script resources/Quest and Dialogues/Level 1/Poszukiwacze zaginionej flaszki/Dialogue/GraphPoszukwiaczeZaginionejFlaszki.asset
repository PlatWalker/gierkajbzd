    - rid: 1666070872287871955
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 2562f8e3-bd72-487c-8d73-9ac244e56fc0
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: efec2ea1-eb9d-489f-9b4a-76e9ebeefe65
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: -212, y: 2217}
        <Text>k__BackingField: "Kto\u015B zajeba\u0142 nam \u201E\u015Awi\u0119tego
          Graala\u201D"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871956
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: efec2ea1-eb9d-489f-9b4a-76e9ebeefe65
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 4f42faf6-a784-47cd-a40e-a73180239d96
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 195, y: 2217}
        <Text>k__BackingField: Nie pierdol!
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b20e773fbde419f4ebba247c92965fd0, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871957
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 4f42faf6-a784-47cd-a40e-a73180239d96
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: ee316dea-0a5d-49c7-831e-62034897af1c
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 602, y: 2217}
        <Text>k__BackingField: "Musimy znale\u017A\u0107 tego zajebanego z\u0142odzieja.
          Piszesz si\u0119?"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871958
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: ee316dea-0a5d-49c7-831e-62034897af1c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 7c9c7588-b9da-4dbe-970c-3cd0c5211229
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1009, y: 2217}
        <Text>k__BackingField: "W sumie to g\xF3wno w tej sprawie mog\u0119 zrobi\u0107.
          Ale pierdoln\u0105\u0107 sobie takiego Graala, to bym pierdoln\u0105\u0142..."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b20e773fbde419f4ebba247c92965fd0, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871959
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 7c9c7588-b9da-4dbe-970c-3cd0c5211229
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 37d7db80-13aa-4235-8a3e-fa0a5b91a536
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1651, y: 2217}
        <Text>k__BackingField: "Chyba ci\u0119 popierdoli\u0142o! Chla\u0107 to ka\u017Cdy,
          ale robi\u0107 to nie ma komu!"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871960
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 37d7db80-13aa-4235-8a3e-fa0a5b91a536
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: a879d4ae-fd02-4089-8e43-f58472ce5ade
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2091, y: 2217}
        <Text>k__BackingField: "Spokojnie, Andrzeju, nie denerwuj si\u0119... Akurat
          znam kogo\u015B, kto m\xF3g\u0142by nam pom\xF3c."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 5804618884b55af47ab30ad4a8ee9877, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871961
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: a879d4ae-fd02-4089-8e43-f58472ce5ade
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 6d0384ab-080b-4185-8269-d9b3587b10eb
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: -619, y: 2523}
        <Text>k__BackingField: Niby kto?
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871962
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 6d0384ab-080b-4185-8269-d9b3587b10eb
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: d1a2525a-89d5-464f-a4d0-99d776a3e86a
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: -212, y: 2523}
        <Text>k__BackingField: "Staszek. Przecie\u017C w wojsku by\u0142. Pewnie
          potrafi wytropi\u0107 kradn\u0105cych wino skurwysyn\xF3w z odleg\u0142o\u015Bci
          pi\u0119ciu kilometr\xF3w."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 5804618884b55af47ab30ad4a8ee9877, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871963
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: d1a2525a-89d5-464f-a4d0-99d776a3e86a
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 280753cb-ca60-4aa8-9994-0ebe05376334
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 430, y: 2523}
        <Text>k__BackingField: "M\u0142ody, jeszcze raz musimy ci\u0119 prosi\u0107
          o przys\u0142ug\u0119. Znajd\u017A Stacha i przekonaj go, \u017Ceby pom\xF3g\u0142
          nam z\u0142apa\u0107 tego zajebanego kradzieja. Sami by\u015Bmy poszli,
          ale rozumiesz... Prawdziwy \u017Co\u0142nierz nie opuszcza swojego posterunku."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 393674affef6eef43876fbc103a34f69, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871964
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 280753cb-ca60-4aa8-9994-0ebe05376334
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 086b3b72-6933-4731-bbca-c2fa086e68e4
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1072, y: 2538}
        <Text>k__BackingField: "Sk\u0105d mam wiedzie\u0107, gdzie jest Stachu?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 393674affef6eef43876fbc103a34f69, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 1
    - rid: 1666070872287871965
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 086b3b72-6933-4731-bbca-c2fa086e68e4
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: f8745265-c8f0-40ed-b8b5-d6768c3d5a47
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1479, y: 2538}
        <Text>k__BackingField: "To nie b\u0119dzie trudne. Jak go znam, to le\u017Cy
          najebany na cmentarzu. Odk\u0105d jego szwagier umar\u0142 na marsko\u015B\u0107
          w\u0105troby, to odwiedza go i chleje, jak to m\xF3wi \u201Erazem z nim\u201D.
          Jak dla mnie, to zdrowo jest pierdolni\u0119ty."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871966
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: f8745265-c8f0-40ed-b8b5-d6768c3d5a47
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: d365af6c-0c3c-4bc4-a575-387a2cb01c83
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2121, y: 2553}
        <Text>k__BackingField: "Troch\u0119 szkoda ch\u0142opa"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871967
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: d365af6c-0c3c-4bc4-a575-387a2cb01c83
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 64a5896e-0aea-4978-ba8c-bcd9b0495726
        <GroupID>k__BackingField: 356ffd76-b0cc-44a0-86b4-fd7c58f91447
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2528, y: 2553}
        <Text>k__BackingField: "Dobra, m\u0142ody. Wiesz, co i jak. B\u0119dziemy
          tu na was czeka\u0107."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
