          <NodeID>k__BackingField: 111cef34-633b-4da1-977d-43dd30afecc5
        <GroupID>k__BackingField: 35e7925f-6b52-4ed2-b8c8-c126395f6174
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 922, y: 1408}
        <Text>k__BackingField: "Nie. Ekspedientka nie ma \u017Cadnego \u201E\u015Awi\u0119tego
          Graala\u201D. Twierdzi, \u017Ce kto\u015B si\u0119 nie ba\u0142 i zajeba\u0142."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
