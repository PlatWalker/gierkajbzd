        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2537, y: 9}
        <Text>k__BackingField: "\u015Awietnie! Oto dwa z\u0142ote! Pospiesz si\u0119,
          m\u0142ody, bo nas suszy jak ja pierdole. "
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
