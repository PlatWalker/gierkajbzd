    - rid: 1666070872287871942
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: aece184d-0846-44b4-934d-a0e8f5fab8b6
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: a7b9c1eb-ed6f-4039-be7f-4feef6bba848
        <GroupID>k__BackingField: f9fbacb0-de54-4f1e-b0af-7ba1fa9a1e91
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1316, y: 128}
        <Text>k__BackingField: "Nie chodzi o \u017Cadne pieni\u0105dze! Wr\u0119cz
          przeciwnie, bo akurat mamy dwa z\u0142ote. Chcemy Ci\u0119 poprosi\u0107
          o drobn\u0105 przys\u0142ug\u0119. Id\u017A do Gra\u017Cyny i kup \u201E\u015Awi\u0119tego
          Graala\u201D, to takie wino. Stara rura nie chce go sprzeda\u0107, bo to
          edycja limitowana. Pewnie trzyma dla kogo\u015B innego."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
