    - rid: 1666070872287871939
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: be7ec927-79f0-48b1-81d3-b8fd1c37d48d
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: ffcad7e1-9c26-4578-a0a6-7f1f546aec2b
        <GroupID>k__BackingField: 7b436126-7c47-411a-ab4b-a4897990938d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 936, y: -591}
        <Text>k__BackingField: "Kurwa, sk\u0142adali\u015Bmy si\u0119 czy nie? Wi\u0119c
          te\u017C mam prawo wybra\u0107. A ja nic poza \u201E\u015Awi\u0119tym Graalem\u201D
          pi\u0142 nie b\u0119d\u0119."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
