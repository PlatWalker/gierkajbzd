        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 288, y: 152}
        <Text>k__BackingField: "Kierowniku! Spraw\u0119 mamy do ciebie! Poratujesz?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 8b0fb904dd04b9e4caf726c0f3ae2379, type: 3}
