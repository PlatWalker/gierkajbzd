        <ID>k__BackingField: d7013667-aea0-4dbb-b36b-a6889c220afb
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Poprosz\u0119 \u201E\u015Awi\u0119tego Graala\u201D"
          <NodeID>k__BackingField: ce9caecf-8aa1-4614-b389-93fa73342800
