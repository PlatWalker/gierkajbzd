    - rid: 1666070872287871948
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: ce9caecf-8aa1-4614-b389-93fa73342800
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: ed70d4e0-4016-4dcb-9bea-0e3a6ac5be5e
        <GroupID>k__BackingField: 30769e52-a8c3-4d72-ba06-fb885e8f7f85
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1547, y: 793}
        <Text>k__BackingField: "O, nast\u0119pny! Jeste\u015B od Zdzicha, tak? Ju\u017C
          m\xF3wi\u0142am tym moczymordom, \u017Ce nie mam czego\u015B takiego w
          sprzeda\u017Cy! Dosta\u0142am tylko jedn\u0105 butelk\u0119 od producenta,
          w celach marketingowych, ale kto\u015B j\u0105 ukrad\u0142, zanim zd\u0105\u017Cy\u0142am
          wystawi\u0107 j\u0105 na p\xF3\u0142k\u0119! W sumie sama bym chcia\u0142a
          wiedzie\u0107, co si\u0119 sta\u0142o z tym winiaczem..."
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 36dbd3da4d777a2458e0042fc459dec0, type: 3}
        <Audio>k__BackingField: {fileID: 0}
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1666070872287871949
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 69186544-2479-4f1b-887a-ca36dd824eb5
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 67cb3097-aac1-47f5-9a63-ee4a4e554ef1
        <GroupID>k__BackingField: 35e7925f-6b52-4ed2-b8c8-c126395f6174
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 446, y: 1406}
        <Text>k__BackingField: "I jak, m\u0142ody? Masz t\u0119 flaszk\u0119?"
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
