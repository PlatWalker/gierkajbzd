        <GroupID>k__BackingField: 0080c7e1-799a-411b-a2f9-25d76daf16b6
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2237, y: 5334}
        <Text>k__BackingField: "Ej, m\u0142ody! Kurwa, zr\xF3b co\u015B! To nie ja,
          s\u0142owo!"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
