    - rid: 1185023230678401758
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: d849ca8a-28da-46bf-9a64-cde8a055ab34
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Nie mam \u017Cadnych pieni\u0119dzy"
          <NextDialogue>k__BackingField: aece184d-0846-44b4-934d-a0e8f5fab8b6
        - <Text>k__BackingField: Wypierdalaj!
          <NextDialogue>k__BackingField: 3a03387f-543d-4e09-8ac1-8a4ed9b089dd
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: 
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 8b0fb904dd04b9e4caf726c0f3ae2379, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 1
    - rid: 1185023230678401759
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: aece184d-0846-44b4-934d-a0e8f5fab8b6
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: a7b9c1eb-ed6f-4039-be7f-4feef6bba848
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Nie chodzi o \u017Cadne pieni\u0105dze! Wr\u0119cz
          przeciwnie, bo akurat mamy dwa z\u0142ote. Chcemy Ci\u0119 poprosi\u0107
          o drobn\u0105 przys\u0142ug\u0119. Id\u017A do Gra\u017Cyny i kup \u201E\u015Awi\u0119tego
          Graala\u201D, to takie wino. Stara rura nie chce go sprzeda\u0107, bo to
          edycja limitowana. Pewnie trzyma dla kogo\u015B innego."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 1185023230678401760
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: a7b9c1eb-ed6f-4039-be7f-4feef6bba848
        <Choices>k__BackingField:
        - <Text>k__BackingField: "W porz\u0105dku. Daj pieni\u0105dze."
          <NextDialogue>k__BackingField: d5be6307-2646-48bd-93f1-b4ace82d8529
        - <Text>k__BackingField: "Nie mam czasu na pierdo\u0142y"
          <NextDialogue>k__BackingField: 8a454214-d00d-49f6-a823-bb7a06436e0f
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: Tekst dialogu...
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 01295fa5bd053974990a134185033d40, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 1
    - rid: 1185023230678401761
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: d5be6307-2646-48bd-93f1-b4ace82d8529
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 04ddf352-c3f7-4952-a26f-1944dbb5ca7e
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "\u015Awietnie! Oto dwa z\u0142ote! Pospiesz si\u0119,
          m\u0142ody, bo nas suszy jak ja pierdole. "
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 4d1d14bab2c7fb343a936edb5a1fe207, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
