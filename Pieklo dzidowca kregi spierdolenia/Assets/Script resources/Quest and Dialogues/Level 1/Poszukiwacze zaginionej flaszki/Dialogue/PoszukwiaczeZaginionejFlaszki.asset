        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Dzie\u0144 dobry. Co poda\u0107?"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 9e1959b9728628d48ada63dee03adcf3, type: 3}
