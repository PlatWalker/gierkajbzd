    - rid: 1185023230678401767
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: d7013667-aea0-4dbb-b36b-a6889c220afb
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Poprosz\u0119 \u201E\u015Awi\u0119tego Graala\u201D"
          <NextDialogue>k__BackingField: ce9caecf-8aa1-4614-b389-93fa73342800
        - <Text>k__BackingField: Do widzenia
          <NextDialogue>k__BackingField: 31248bcd-c6d8-4a98-b271-fe2512f12854
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
