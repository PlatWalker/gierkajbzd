          OutputGuid: f5070702-81c7-4fa5-8a87-8656c446ff4e
          Text: "Podejrzewa pani kogo\u015B o kradzie\u017C \u201E\u015Awi\u0119tego
            Graala\u201D?"
        - PortGuid: 25eb9982-5eed-4d1f-9f37-0235eaaa2a5d
          InputGuid: bc891b11-e374-4923-b1e3-fc4500d1a6d8
          OutputGuid: f5070702-81c7-4fa5-8a87-8656c446ff4e
          Text: "Mo\u017Ce co\u015B do picia..."
        - PortGuid: a7debbc2-a928-45b7-82d1-67c36558e036
          InputGuid: 
          OutputGuid: 
          Text: "Jeszcze si\u0119 zastanawiam."
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Dzie\u0144 dobry, co poda\u0107?"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 9e1959b9728628d48ada63dee03adcf3, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
