        <DialogueNodePorts>k__BackingField:
        - PortGuid: 350b1ca9-8d0a-4cc2-9f70-e64722878e08
          InputGuid: bc891b11-e374-4923-b1e3-fc4500d1a6d8
          OutputGuid: 31746449-8c6e-4293-babd-3610cd382ab2
          Text: "To ja mo\u017Ce kupi\u0119 co\u015B innego..."
        - PortGuid: 108cbe49-8c6f-4099-9e69-134efd990755
          InputGuid: f93822a2-c892-47df-87fc-d52bf62d5477
          OutputGuid: 31746449-8c6e-4293-babd-3610cd382ab2
          Text: Rozumiem, do widzenia!
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "O, nast\u0119pny! Jeste\u015B od Zdzicha, tak? Ju\u017C
          m\xF3wi\u0142am tym moczymordom, \u017Ce nie mam czego\u015B takiego w
          sprzeda\u017Cy! Dosta\u0142am tylko jedn\u0105 butelk\u0119 od producenta,
          w celach marketingowych, ale kto\u015B j\u0105 ukrad\u0142, zanim zd\u0105\u017Cy\u0142am
          wystawi\u0107 j\u0105 na p\xF3\u0142k\u0119! W sumie sama bym chcia\u0142a
          wiedzie\u0107, co si\u0119 sta\u0142o z tym winiaczem..."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 36dbd3da4d777a2458e0042fc459dec0, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
