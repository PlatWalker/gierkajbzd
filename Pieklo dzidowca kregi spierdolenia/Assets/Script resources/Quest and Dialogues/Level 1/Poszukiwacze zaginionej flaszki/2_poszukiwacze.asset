    - rid: 4751322064480895279
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 31746449-8c6e-4293-babd-3610cd382ab2
