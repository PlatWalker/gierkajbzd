        <GroupID>k__BackingField: 38ed60b0-cfde-41cf-bc08-87b8ebc681ab
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1302, y: 3431}
        <Text>k__BackingField: "M\u0142ody, przeszukaj okolice monopolowego, mo\u017Ce
          znajdziesz jakie\u015B \u015Blady!"
        <PlayerImage>k__BackingField: {fileID: 0}
