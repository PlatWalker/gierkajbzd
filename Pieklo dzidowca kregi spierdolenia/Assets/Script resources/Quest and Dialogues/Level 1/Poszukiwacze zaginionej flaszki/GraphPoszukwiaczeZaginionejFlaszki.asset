        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 7
        <Position>k__BackingField: {x: 4115, y: 2628}
        <SelectedGroup>k__BackingField: Grupa7
    - rid: 4904837055787565447
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: dc2ca2d7-6689-4658-bc17-10ff0d06cf48
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 9184f140-a287-4823-bb4c-6af3da95b1c2
        <GroupID>k__BackingField: e2612a0a-5aea-4fc6-8565-926d2d00a6af
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 364, y: 3049}
        <Text>k__BackingField: "Wybacz, Micha\u0142ku, ale to sprawa niecierpi\u0105ca
          zw\u0142oki. Wr\xF3cimy do tej rozmowy."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565448
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
