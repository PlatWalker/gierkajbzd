          <NodeID>k__BackingField: 6a6ac287-7d02-4c00-a73a-935e56ca8e44
        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1258, y: 2620}
        <Text>k__BackingField: A kto przy telefonie?
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565442
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 6a6ac287-7d02-4c00-a73a-935e56ca8e44
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: b0ee539b-0f42-4121-88a6-f87dbc38947f
        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1710, y: 2624}
        <Text>k__BackingField: "Zdzichu Jones z ekip\u0105 potrzebuj\u0105 twojej
          pomocy."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565443
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: b0ee539b-0f42-4121-88a6-f87dbc38947f
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 2431dd23-9e1d-4699-8f69-f370841a7c2f
        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2154, y: 2622}
        <Text>k__BackingField: "Przeka\u017C Zdzichowi i ekipie, \u017Ce mog\u0105
          spierdala\u0107. My tu teraz z Micha\u0142kiem mamy wa\u017Cne spotkanie
          rodzinne."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565444
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 2431dd23-9e1d-4699-8f69-f370841a7c2f
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 2314501a-df4f-4ebe-a86f-d41635722af2
        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2842, y: 2626}
        <Text>k__BackingField: "Kurwa, Stachu, wstawaj! Ojczyzna ci\u0119 potrzebuje!
          Kto\u015B podpierdoli\u0142 \u201E\u015Awi\u0119tego Graala\u201D!"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565445
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 2314501a-df4f-4ebe-a86f-d41635722af2
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 0f182ac6-ffc0-4b4d-84ed-a993ff60826c
        <GroupID>k__BackingField: 69b221b1-0bc6-4a1b-8c8f-7e7d5bcaa60d
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 3445, y: 2626}
        <Text>k__BackingField: "\u201EGraala\u201D?! Gra\u017Cynka mia\u0142a go
          dla mnie przetrzyma\u0107, a\u017C uzbieram dwa z\u0142ote! Brakuje mi
          jeszcze... dwa z\u0142ote..."
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565446
      type: {class: EndGroupNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
