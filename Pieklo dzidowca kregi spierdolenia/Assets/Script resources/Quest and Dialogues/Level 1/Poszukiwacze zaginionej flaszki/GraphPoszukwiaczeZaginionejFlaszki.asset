        <GroupID>k__BackingField: e2612a0a-5aea-4fc6-8565-926d2d00a6af
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 956, y: 3047}
        <Text>k__BackingField: "Prowad\u017A, m\u0142ody!"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 4904837055787565449
