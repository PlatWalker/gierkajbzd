        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "M\xF3wi\u0119 ci, Micha\u0142ku. Zasrane to \u017Cycie."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b823da9b96a205644ae2f0f0a944e584, type: 3}
