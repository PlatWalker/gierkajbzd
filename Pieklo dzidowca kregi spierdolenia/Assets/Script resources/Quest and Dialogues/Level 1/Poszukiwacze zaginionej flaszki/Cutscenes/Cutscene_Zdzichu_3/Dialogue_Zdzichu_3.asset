      data:
        <NodeId>k__BackingField: 2c8d305b-d778-410d-bbcb-aa33a8c026ef
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 6ae6847b-7145-4d69-a559-547ceba7fbec
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: Stachu?
        <NpcImage>k__BackingField: {fileID: 0}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
    - rid: 6426248040834924738
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 6ae6847b-7145-4d69-a559-547ceba7fbec
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: b56049e4-2e9f-4eff-b2e2-e6c93269f113
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: A kto przy telefonie?
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        <PlayerImage>k__BackingField: {fileID: 0}
    - rid: 6426248040834924739
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: b56049e4-2e9f-4eff-b2e2-e6c93269f113
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: b731acc4-1475-4a75-a0b9-dc3c32807c77
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Zdzichu Jones z ekip\u0105 potrzebuj\u0105 twojej
          pomocy."
        <NpcImage>k__BackingField: {fileID: 0}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
    - rid: 6426248040834924740
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: b731acc4-1475-4a75-a0b9-dc3c32807c77
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: b8be69f0-df1e-4ff9-8b43-ee23a62a115e
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Przeka\u017C Zdzichowi i ekipie, \u017Ce mog\u0105
          spierdala\u0107. My tu teraz z Micha\u0142kiem mamy wa\u017Cne spotkanie
          rodzinne."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        <PlayerImage>k__BackingField: {fileID: 0}
    - rid: 6426248040834924741
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: b8be69f0-df1e-4ff9-8b43-ee23a62a115e
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 5f34131d-5f79-4670-ad05-c46e5ee43c54
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Kurwa, Stachu, wstawaj! Ojczyzna ci\u0119 potrzebuje!
          Kto\u015B podpierdoli\u0142 \u201E\u015Awi\u0119tego Graala\u201D!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 393674affef6eef43876fbc103a34f69, type: 3}
        <PlayerImage>k__BackingField: {fileID: 0}
    - rid: 6426248040834924742
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 5f34131d-5f79-4670-ad05-c46e5ee43c54
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 3c1b39cb-a21c-40fb-ad99-528e22c68b92
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "\u201EGraala\u201D?! Gra\u017Cynka mia\u0142a go
          dla mnie przetrzyma\u0107, a\u017C uzbieram dwa z\u0142ote! Brakuje mi
          jeszcze... dwa z\u0142ote..."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 489b378ea2814d7479cc1d2db0094d3e, type: 3}
        <PlayerImage>k__BackingField: {fileID: 0}
