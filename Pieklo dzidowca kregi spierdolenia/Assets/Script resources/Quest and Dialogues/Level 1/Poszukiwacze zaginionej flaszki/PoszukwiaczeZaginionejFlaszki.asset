        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Daj spok\xF3j, Zbysiu. We\u017Amiemy co\u015B innego."
        <NpcImage>k__BackingField: {fileID: 0}
        <PlayerImage>k__BackingField: {fileID: 0}
    - rid: 4904837055787565516
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: ba0c73c6-5590-4c92-97e2-2e1a67acc039
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 464b1688-31b8-479c-b93f-b9def9cde7a6
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Kurwa, sk\u0142adali\u015Bmy si\u0119 czy nie? Wi\u0119c
          te\u017C mam prawo wybra\u0107. A ja nic poza \u201E\u015Awi\u0119tym Graalem\u201D
          pi\u0142 nie b\u0119d\u0119."
        <NpcImage>k__BackingField: {fileID: 0}
        <PlayerImage>k__BackingField: {fileID: 0}
    - rid: 4904837055787565517
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 464b1688-31b8-479c-b93f-b9def9cde7a6
        <Choices>k__BackingField:
