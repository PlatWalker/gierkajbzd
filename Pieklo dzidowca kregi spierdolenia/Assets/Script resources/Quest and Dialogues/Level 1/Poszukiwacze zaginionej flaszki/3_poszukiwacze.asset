        <NodeGuid>k__BackingField: 3d041cd0-d9bd-42bf-900c-784acdac6647
        <Position>k__BackingField: {x: 295, y: 509}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: cd18b74e-ca20-4eb3-8ea7-ed769c8ae4cc
          InputGuid: d62c1954-694e-43c4-a502-b4a14c75e2ee
          OutputGuid: 3d041cd0-d9bd-42bf-900c-784acdac6647
          Text: Koniec
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Patrz, ch\u0142opcze. Ten tu Micha\u0142ek, co mu
