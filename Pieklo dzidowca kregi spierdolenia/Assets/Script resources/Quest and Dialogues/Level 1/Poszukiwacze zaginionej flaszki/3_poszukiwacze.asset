    - rid: 4751322064480895123
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 8ef579c7-c1fb-429e-9281-e0412f9b10e7
        <Position>k__BackingField: {x: 1539, y: 233}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 50ecb7c0-b69d-41ce-a699-7adb0bf22f42
          InputGuid: 3c08b93e-4de4-4733-bd08-4bce1f73008c
          OutputGuid: 8ef579c7-c1fb-429e-9281-e0412f9b10e7
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: A kto przy telefonie?
        <npcSprite>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
