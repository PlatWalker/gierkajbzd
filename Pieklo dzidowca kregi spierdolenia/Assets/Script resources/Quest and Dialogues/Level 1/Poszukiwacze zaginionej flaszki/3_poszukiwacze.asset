        <DialogueNodePorts>k__BackingField:
        - PortGuid: 49881afd-5538-4fb4-b7bd-cc271cf634b3
          InputGuid: 
          OutputGuid: 
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Przeka\u017C Zdzichowi i ekipie, \u017Ce mog\u0105
          spierdala\u0107. My tu teraz z Micha\u0142kiem mamy wa\u017Cne spotkanie
          rodzinne."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: b33653120d937da42970224c6d08d2b2, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Stachu
    - rid: 4751322064480895127
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 3c08b93e-4de4-4733-bd08-4bce1f73008c
        <Position>k__BackingField: {x: 2173, y: 232.5}
