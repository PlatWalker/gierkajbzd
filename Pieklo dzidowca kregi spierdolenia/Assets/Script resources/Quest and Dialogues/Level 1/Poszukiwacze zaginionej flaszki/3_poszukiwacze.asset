    - rid: 4751322064480895124
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: d31b69d4-199e-44a8-8cf1-cb481b218934
        <Position>k__BackingField: {x: 4058.5, y: 235}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 81115dd5-c11c-4259-ac98-c27f584d18fa
          InputGuid: 86d271e0-022b-4125-bef4-2cf2684c66a0
          OutputGuid: d31b69d4-199e-44a8-8cf1-cb481b218934
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "\u201EGraala\u201D?! Gra\u017Cynka mia\u0142a go
          dla mnie przetrzyma\u0107, a\u017C uzbieram dwa z\u0142ote! Brakuje mi
          jeszcze... dwa z\u0142ote..."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 489b378ea2814d7479cc1d2db0094d3e, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Stachu
    - rid: 4751322064480895125
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: ccfb18ef-140e-46e3-8871-77605a0ca649
        <Position>k__BackingField: {x: 3428.5, y: 235.5}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: a2e8c203-b2c9-4f68-8b99-f04834e95e04
          InputGuid: d31b69d4-199e-44a8-8cf1-cb481b218934
          OutputGuid: ccfb18ef-140e-46e3-8871-77605a0ca649
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Dobra, przeka\u017C\u0119, \u017Ce nie obchodzi ci\u0119,
          kto ukrad\u0142 \"\u015Awi\u0119tego Graala\"..."
        <npcSprite>k__BackingField: {fileID: 0}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
        <Name>k__BackingField: Anon
    - rid: 4751322064480895126
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: b1a0c496-a34f-4ce2-8e9f-c43d8c4a7c90
