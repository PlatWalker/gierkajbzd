        <Text>k__BackingField: O czym ty pierdolisz?
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 19ad5b6eca17266488f676edaae8fbc5, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
        <Name>k__BackingField: Zdzichu Jones
    - rid: 4751322064480895251
