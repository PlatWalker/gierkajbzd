    - rid: 7380097134202978395
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 3823e2eb-5761-42f1-bf98-618e4c26dbf7
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 6ebef697-1760-477c-8a34-34fb24580e27
        <GroupID>k__BackingField: feb0a04e-82f0-4e4a-9855-6ac9fc62ff47
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 2304, y: -10}
        <Text>k__BackingField: "Jak za starych, dobrych czas\xF3w!"
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 7380097134202978396
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 4658b5cf-91fc-478b-9bbf-a434e3c4a534
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 50efd633-0825-4235-9537-4362789eda97
        <GroupID>k__BackingField: 75883762-ea52-4974-bf7c-7a1b1f30fdea
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 171, y: 434}
        <Text>k__BackingField: To chyba klucz do skrzyni w naszej starej bazie. Ciekawe
          czy jeszcze tam jest?
        <PlayerImage>k__BackingField: {fileID: 0}
        <NpcImage>k__BackingField: {fileID: 0}
        <Audio>k__BackingField: {fileID: 0}
    - rid: 7380097134202978397
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 44c081ef-8c85-42be-89be-ffd194f2a42c
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 6f9327b4-7738-41a3-810b-c5d2f5c6e3ad
        <GroupID>k__BackingField: fae2fce0-20fa-4760-ba7d-774d2d7e68b7
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 1087, y: 441}
        <Text>k__BackingField: "Wszystko wygl\u0105da jak kiedy\u015B. Mo\u017Ce
          g\xF3wniaki jeszcze wszystkiego nie zniszczy\u0142y."
        <PlayerImage>k__BackingField: {fileID: 0}
