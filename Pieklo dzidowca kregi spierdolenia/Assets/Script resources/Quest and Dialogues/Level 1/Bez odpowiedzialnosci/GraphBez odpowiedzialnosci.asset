      data:
        <ID>k__BackingField: 9fd23174-1fc9-42cb-9e9e-a4fa489435f6
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NodeID>k__BackingField: 2e9d582b-580e-4781-8c9a-a3d344d977bb
        <GroupID>k__BackingField: d22b7746-7f3d-4445-9afa-c3bf2c5449cd
        <NodeType>k__BackingField: 0
        <Position>k__BackingField: {x: 419, y: -136}
        <Text>k__BackingField: "Czego tu? Matka ci\u0119 nie uczy\u0142a, \u017Ce
