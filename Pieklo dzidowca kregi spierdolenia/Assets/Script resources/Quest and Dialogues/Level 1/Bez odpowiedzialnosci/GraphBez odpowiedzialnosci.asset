    - rid: 6327991057950441822
      type: {class: DialogueNodeEditorData, ns: jbzd.Dialogues.Editor.Save, asm: Assembly-CSharp-Editor}
      data:
        <ID>k__BackingField: 2e9d582b-580e-4781-8c9a-a3d344d977bb
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Hajda? Ten, co przejecha\u0142 staruszk\u0119 na
            pasach?"
          <NodeID>k__BackingField: 4c502782-2062-4f8f-8d4c-009a6158c8f8
        - <Text>k__BackingField: "Przepraszam, ja tylko t\u0119dy przechodzi\u0142em"
          <NodeID>k__BackingField: fba5c4ce-6e80-4f89-a9ff-fd22ed1ffc96
        <GroupID>k__BackingField: d22b7746-7f3d-4445-9afa-c3bf2c5449cd
