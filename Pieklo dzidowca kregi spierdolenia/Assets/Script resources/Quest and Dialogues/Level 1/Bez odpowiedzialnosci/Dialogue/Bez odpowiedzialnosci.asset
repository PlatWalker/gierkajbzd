        <Text>k__BackingField: "Dzi\u0119kujemy ci, m\u0142ody cz\u0142owieku, co
          by\u015Bmy bez ciebie zrobi\u0142y"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 693384a8fef9a524094c4a7f8e4f6f57, type: 3}
