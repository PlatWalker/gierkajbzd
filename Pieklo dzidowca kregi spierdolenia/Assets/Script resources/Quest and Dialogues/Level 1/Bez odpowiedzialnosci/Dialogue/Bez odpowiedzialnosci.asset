        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Jeszcze tu jeste\u015B, antychry\u015Bcie?"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: c51823d45f6f65446ab2bf849cd7527a, type: 3}
