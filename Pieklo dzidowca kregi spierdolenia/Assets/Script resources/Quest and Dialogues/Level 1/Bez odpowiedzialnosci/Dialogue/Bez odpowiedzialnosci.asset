    - rid: 2042778512612393410
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: ed890557-c11f-4259-b979-c7a2819c08f9
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nie ma sprawy, babciu
          <NextDialogue>k__BackingField: e6d5bf26-a607-4660-aa99-d36b3047250b
        - <Text>k__BackingField: "I dobrze, niech was wszystkie porozje\u017Cd\u017Ca"
          <NextDialogue>k__BackingField: 83faac94-ddd4-4cb5-9856-2ed1481864bc
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "S\u0142uchaj, m\u0142ody cz\u0142owieku. Nabo\u017Ce\u0144stwo
          si\u0119 sko\u0144czy\u0142o dwie godziny temu, a my tu wci\u0105\u017C
          siedzimy, bo boimy si\u0119 wr\xF3ci\u0107 do domu, ten antychryst pewnie
          czai si\u0119 niedaleko jakiego\u015B przej\u015Bcia. Pom\xF3g\u0142by\u015B
          nas przeprowadzi\u0107 przez jezdni\u0119? Zrobi\u0142by\u015B dobry uczynek
          i przy okazji zarobi\u0142 troch\u0119 pieni\u0105\u017Ck\xF3w na lody."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: 693384a8fef9a524094c4a7f8e4f6f57, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 1
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2042778512612393411
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 2149ca95-4388-454f-a413-896d59ab11dc
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: ed890557-c11f-4259-b979-c7a2819c08f9
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "To wszystko wina Tuska! Teraz Hajda my\u015Bli, \u017Ce
          jest ca\u0142kowicie bezkarny i poluje na nas, poczciwych emeryt\xF3w.
          A\u017C strach przez pasy przej\u015B\u0107..."
        <NpcImage>k__BackingField: {fileID: 21300000, guid: c51823d45f6f65446ab2bf849cd7527a, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2042778512612393412
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: eb2c1e3f-c8c4-4f89-b312-eeb6d40a28ee
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 2149ca95-4388-454f-a413-896d59ab11dc
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Do tego unikn\u0105\u0142 odpowiedzialno\u015Bci
          za swoje przest\u0119pstwo!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: fae910a9f7844c24fa22cdf28b989e76, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2042778512612393413
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 8db20b6e-1b10-4409-a696-8fc265edf54d
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: eb2c1e3f-c8c4-4f89-b312-eeb6d40a28ee
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "\rPotr\u0105ci\u0142 nasz\u0105 kole\u017Cank\u0119,
          kiedy sz\u0142a na k\xF3\u0142ko r\xF3\u017Ca\u0144cowe!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: c51823d45f6f65446ab2bf849cd7527a, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2042778512612393414
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 4c502782-2062-4f8f-8d4c-009a6158c8f8
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nastepny dialog
          <NextDialogue>k__BackingField: 8db20b6e-1b10-4409-a696-8fc265edf54d
        <NodeType>k__BackingField: 0
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Ten sam! Bezbo\u017Cnik jeden, tfu!"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: fae910a9f7844c24fa22cdf28b989e76, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
        <ShowPlayerResponse>k__BackingField: 0
        <IsPlayerTalking>k__BackingField: 0
    - rid: 2042778512612393415
      type: {class: DialogueRuntimeData, ns: jbzd.Dialogues.RuntimeData, asm: Assembly-CSharp}
      data:
        <NodeId>k__BackingField: 2e9d582b-580e-4781-8c9a-a3d344d977bb
        <Choices>k__BackingField:
        - <Text>k__BackingField: "Hajda? Ten, co przejecha\u0142 staruszk\u0119 na
            pasach?"
          <NextDialogue>k__BackingField: 4c502782-2062-4f8f-8d4c-009a6158c8f8
        - <Text>k__BackingField: "Przepraszam, ja tylko t\u0119dy przechodzi\u0142em"
          <NextDialogue>k__BackingField: fba5c4ce-6e80-4f89-a9ff-fd22ed1ffc96
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 1
        <Text>k__BackingField: "Czego tu? Matka ci\u0119 nie uczy\u0142a, \u017Ce
          nie\u0142adnie jest si\u0119 tak gapi\u0107?"
        <NpcImage>k__BackingField: {fileID: 21300000, guid: fae910a9f7844c24fa22cdf28b989e76, type: 3}
        <PlayerImage>k__BackingField: {fileID: 21300000, guid: 322c97448bea9ca46a04ae059e483d60, type: 3}
