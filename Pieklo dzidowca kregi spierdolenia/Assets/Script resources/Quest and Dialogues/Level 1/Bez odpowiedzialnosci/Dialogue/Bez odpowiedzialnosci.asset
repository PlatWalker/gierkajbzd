        <NodeId>k__BackingField: 72079484-b56c-4b81-81e8-e91a6eac33f5
        <Choices>k__BackingField:
        - <Text>k__BackingField: Nie ma sprawy, babciu
          <NextDialogue>k__BackingField: 99bb8f4a-b08d-46b7-95ff-9f295dfc06e8
        - <Text>k__BackingField: Nie ma mowy
          <NextDialogue>k__BackingField: e974ff5d-a686-4c0e-8b75-6cd7e3b9a46c
        <NodeType>k__BackingField: 1
        <IsStartingDialogue>k__BackingField: 0
        <Text>k__BackingField: "Uspok\xF3j si\u0119, Gienia. Naprawd\u0119 potrzebujemy
          twojej pomocy, m\u0142odzie\u0144cze. Pomo\u017Cesz schorowanym staruszkom?"
