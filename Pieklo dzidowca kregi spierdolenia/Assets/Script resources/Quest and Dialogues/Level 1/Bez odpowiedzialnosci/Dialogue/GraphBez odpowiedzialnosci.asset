        <Choices>k__BackingField:
        - <Text>k__BackingField: Nie ma sprawy, babciu
          <NodeID>k__BackingField: e6d5bf26-a607-4660-aa99-d36b3047250b
        - <Text>k__BackingField: "I dobrze, niech was wszystkie porozje\u017Cd\u017Ca"
          <NodeID>k__BackingField: 83faac94-ddd4-4cb5-9856-2ed1481864bc
        <GroupID>k__BackingField: d22b7746-7f3d-4445-9afa-c3bf2c5449cd
