    - rid: 4751322032789259053
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: ca792dae-2d24-4743-8647-c295036b3030
        <Position>k__BackingField: {x: 2824, y: 249}
        <DialogueNodePorts>k__BackingField:
        - PortGuid: 930b59ad-01bf-4dc3-9263-ae7601e55d7f
          InputGuid: 9ce13ed3-78ff-4759-af28-71d87316d248
          OutputGuid: ca792dae-2d24-4743-8647-c295036b3030
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Ten komputer ju\u017C ci ca\u0142kiem na m\xF3zg
          siad\u0142! Wyszed\u0142by\u015B na dw\xF3r, przyda\u0142 si\u0119 do czego\u015B,
          a nie ca\u0142ymi dniami w tej norze siedzisz! \u017Badnego z ciebie po\u017Cytku,
          drugi ojciec!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 190731da76bf37346aa29beab51e1412, type: 3}
        <playerSprite>k__BackingField: {fileID: 21300000, guid: f2d2a7d738e8e75488c4fea351131b93, type: 3}
        <Name>k__BackingField: Madka
    - rid: 4751322032789259054
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 9ce13ed3-78ff-4759-af28-71d87316d248
