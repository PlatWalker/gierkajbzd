          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Nic nie robisz, tylko chlejesz piwsko ca\u0142ymi
          dniami i jeszcze moje wychla\u0142e\u015B! Matka mia\u0142a racj\u0119,
          co do ciebie...!"
        <npcSprite>k__BackingField: {fileID: 21300000, guid: 190731da76bf37346aa29beab51e1412, type: 3}
