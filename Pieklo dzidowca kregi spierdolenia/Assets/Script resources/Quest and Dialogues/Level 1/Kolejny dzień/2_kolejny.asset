          OutputGuid: 18859d97-1126-4017-bd65-cc1bff89abbe
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Masz tutaj kas\u0119, p\xF3jdziesz do Gra\u017Cyny
          po fajki i jaki\u015B czteropak."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: fb189889408b4ae4f88f77fdbcc0ab35, type: 3}
