    - rid: 4751322032789259057
      type: {class: DialogueNodeData, ns: jbzdy.DialogueSystem.NodeDatas, asm: Assembly-CSharp}
      data:
        <NodeGuid>k__BackingField: 158aff27-2131-4675-be77-102807c02577
