          OutputGuid: fb18fed9-af03-41df-aaef-3488de5bae6b
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Ile razy mam Ci\u0119, kurwa, wo\u0142a\u0107? G\u0142uchy
