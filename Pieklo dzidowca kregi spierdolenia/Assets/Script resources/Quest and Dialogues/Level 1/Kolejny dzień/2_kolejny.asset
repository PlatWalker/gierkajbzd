          OutputGuid: 9ce13ed3-78ff-4759-af28-71d87316d248
          Text: Dalej
        <AudioClip>k__BackingField: {fileID: 0}
        <Text>k__BackingField: "Szczym ryj, powiedzia\u0142em..."
        <npcSprite>k__BackingField: {fileID: 21300000, guid: b3acfe7c911c46a43bf97c3d6e97c719, type: 3}
        <playerSprite>k__BackingField: {fileID: 0}
