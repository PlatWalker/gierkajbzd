Toolbar
{
    background-color: #1D1D1E;
    height: 35px;
}

TextField
{
    padding: 4px;
}

.Button
{
    background-color: #252729;
    border-color: #1D1D1E;
    max-height: 25px;
    margin: 4px;
}

.Button:hover
{
    background-color: #2B2D2F;
}

.Button:active
{
    background-color: #212325;
}

.unity-text-field__label
{
    padding: 4px;
}

.unity-text-field__input
{
    background-color: #1D1D1E;
    border-color: #27292C;
    border-radius: 4px;
    max-height: 25px;
    min-width: 120px;
    padding-left: 6px;
}
