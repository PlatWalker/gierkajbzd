        LanguageGenericType: Continue
      - LanguageType: 2
        LanguageGenericType: Continue
    DialogueFaceImageType: 0
    AudioClips:
    - LanguageType: 0
      LanguageGenericType: {fileID: 0}
    - LanguageType: 1
      LanguageGenericType: {fileID: 0}
    - LanguageType: 2
      LanguageGenericType: {fileID: 0}
    TextLanguages:
    - LanguageType: 0
      LanguageGenericType: "Pomo\u017Cesz mi go odzyska\u0107? Mam jeszcze ze dwa
        cukierki ze \u015Bwi\u0105t, kt\xF3re dwa lata temu zajeba\u0142em Mareczkowi
        jak si\u0119 napierdalali\u015Bmy pod Biedronk\u0105. Spa\u0142em na nich,
        to chyba g\xF3wniarze ich nie zauwa\u017Cyli... "
    - LanguageType: 1
      LanguageGenericType: 
    - LanguageType: 2
      LanguageGenericType: 
