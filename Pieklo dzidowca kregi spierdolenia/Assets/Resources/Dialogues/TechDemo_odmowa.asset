  DialogueNodeDatas:
  - NodeGuid: 5344a3da-3918-499f-a06e-abfcc3f04e73
    Position: {x: 402, y: 283}
    DialogueNodePorts:
    - PortGuid: a8110435-efe6-4468-b878-35f2935b9b88
      InputGuid: 5a474cfc-706d-461f-bbb8-031f75ad6d27
      OutputGuid: 5344a3da-3918-499f-a06e-abfcc3f04e73
