      OutputGuid: fca14536-2a80-41ba-b60a-6370697e6f5b
      TextLanguages:
      - LanguageType: 0
        LanguageGenericType: "Czemu sprzedawczyni nie we\u017Amie policji? "
      - LanguageType: 1
        LanguageGenericType: Continue
      - LanguageType: 2
        LanguageGenericType: Continue
    AudioClips:
    - LanguageType: 0
