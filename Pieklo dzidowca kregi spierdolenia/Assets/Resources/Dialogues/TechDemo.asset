      OutputGuid: 10706204-dd17-43fe-bdee-60565adcce3d
      TextLanguages:
      - LanguageType: 0
        LanguageGenericType: "Mmm... cukierasy ( \u0CA0 \u035C\u0296\u0CA0)"
      - LanguageType: 1
        LanguageGenericType: Continue
      - LanguageType: 2
        LanguageGenericType: Continue
    - PortGuid: db48a283-27d3-4543-8934-b4d645e0b51e
      InputGuid: 2c61969d-1c0b-43f3-afef-d00a3393e09a
      OutputGuid: 10706204-dd17-43fe-bdee-60565adcce3d
      TextLanguages:
      - LanguageType: 0
        LanguageGenericType: Spieprzaj, dziadu!
      - LanguageType: 1
        LanguageGenericType: Continue
      - LanguageType: 2
        LanguageGenericType: Continue
    AudioClips:
    - LanguageType: 0
      LanguageGenericType: {fileID: 0}
    - LanguageType: 1
      LanguageGenericType: {fileID: 0}
    - LanguageType: 2
      LanguageGenericType: {fileID: 0}
    TextLanguages:
    - LanguageType: 0
      LanguageGenericType: "Pomo\u017Cesz mi go odzyska\u0107? Mam jeszcze ze dwa
        cukierki ze \u015Bwi\u0105t, kt\xF3re dwa lata temu zajeba\u0142em Mareczkowi
        jak si\u0119 napierdalali\u015Bmy pod Biedronk\u0105. Spa\u0142em na nich,
        to chyba g\xF3wniarze ich nie zauwa\u017Cyli... "
    - LanguageType: 1
      LanguageGenericType: 
    - LanguageType: 2
      LanguageGenericType: 
