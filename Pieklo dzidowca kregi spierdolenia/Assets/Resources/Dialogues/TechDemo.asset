    - LanguageType: 1
      LanguageGenericType: {fileID: 0}
    - LanguageType: 2
      LanguageGenericType: {fileID: 0}
    TextLanguages:
    - LanguageType: 0
      LanguageGenericType: "W ko\u0144cu wyszli i widzia\u0142em jak szli w kierunku
