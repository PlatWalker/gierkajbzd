# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/Pieklo dzidowca kregi spierdolenia/[Ll]ibrary/
/Pieklo dzidowca kregi spierdolenia/[Tt]emp/
/Pieklo dzidowca kregi spierdolenia/[Oo]bj/
/Pieklo dzidowca kregi spierdolenia/[Bb]uild/
/Pieklo dzidowca kregi spierdolenia/[Bb]uilds/
/Pieklo dzidowca kregi spierdolenia/[Ll]ogs/
/Pieklo dzidowca kregi spierdolenia/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/Pieklo dzidowca kregi spierdolenia/[Mm]emoryCaptures/

# Recordings can get excessive in size
/Pieklo dzidowca kregi spierdolenia/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Pieklo dzidowca kregi spierdolenia/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Pieklo dzidowca kregi spierdolenia/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/Pieklo dzidowca kregi spierdolenia/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/Pieklo dzidowca kregi spierdolenia/[Aa]ssets/[Ss]treamingAssets/aa.meta
/Pieklo dzidowca kregi spierdolenia/[Aa]ssets/[Ss]treamingAssets/aa/*
